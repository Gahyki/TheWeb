{
  "name": "theweb",
  "version": "1.0.0",
  "description": "Personal website of Jason Kim, a software engineer in Vancouver, Canada.",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,green \"vite\" \"tsx watch server/index.ts\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json && tsc -p tsconfig.api.json && tsc -p tsconfig.tests.json",
    "test": "tsx --test tests/*.test.ts",
    "test:ui": "playwright test",
    "build:server": "tsc -p tsconfig.server.json --noEmit false --outDir build/server",
    "build": "npm run typecheck && npm run build:server && vite build",
    "start:api": "node build/server/index.js",
    "preview": "vite preview"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gahyki/TheWeb.git"
  },
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Gahyki/TheWeb/issues"
  },
  "homepage": "https://github.com/Gahyki/TheWeb#readme",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=26 <27"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@playwright/test": "^1.65.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/three": "^0.187.0",
    "dotenv": "^18.0.10",
    "emailjs": "^5.0.4",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "gsap": "^3.15.1",
    "helmet": "^8.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "three": "^0.187.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  }
}
