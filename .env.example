API_PORT=3001
# Bind address. Unset means 127.0.0.1 (loopback) for local runs. The Docker
# image sets HOST=0.0.0.0 itself; do not set it here, because env-file values
# override the image and an empty value binds every interface.
# HOST=127.0.0.1
TRUST_PROXY_HOPS=0
CONTACT_RATE_LIMIT=5
CONTACT_RATE_LIMIT_WINDOW_MS=900000
APP_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE_URL=
PROFILE_BIRTH_YEAR=
PROFILE_BIRTH_MONTH=
PROFILE_TIME_ZONE=America/Vancouver
VITE_PUBLIC_CONTACT_EMAIL=contact@gahyki.com

# Optional: raises GitHub API limits and enables the real contribution
# calendar on the GitHub section. Use a fine-grained token with NO repository
# access (public profile data only): a token that can read private repos
# would publish private-repo contribution counts in the public calendar.
GITHUB_TOKEN=
GITHUB_USERNAME=Gahyki

# Contact email delivery settings. Configure SMTP to enable sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
CONTACT_FROM=
CONTACT_TO=contact@gahyki.com
